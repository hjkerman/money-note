# Copy this file to .env.deploy and run: chmod 600 .env.deploy
MONEY_NOTE_API_BASE_URL=https://money.hjkerman.re.kr
MONEY_NOTE_DEPLOY_HOST=your-server.example.com
MONEY_NOTE_DEPLOY_USER=your-ssh-user
MONEY_NOTE_DEPLOY_PORT=32619
MONEY_NOTE_DEPLOY_BRANCH=main
MONEY_NOTE_DEPLOY_REPO_PATH=/opt/money-note
MONEY_NOTE_DEPLOY_WEB_ROOT=/var/www/money
MONEY_NOTE_DEPLOY_REMOTE_APK_PATH=/opt/money-note/downloads/money-note.apk

# Optional. Leave empty to use SSH config or ssh-agent. For a YubiKey-backed
# SSH key, this is the local OpenSSH key-handle file, not private key material.
MONEY_NOTE_DEPLOY_IDENTITY_FILE=

# Release signing may instead remain in mobile/android/key.properties.
# Do not commit the completed .env.deploy file.
# MONEY_NOTE_KEYSTORE_PATH=/Users/you/keys/money-note-release.jks
# MONEY_NOTE_KEYSTORE_PASSWORD=change-me
# MONEY_NOTE_KEY_ALIAS=money-note
# MONEY_NOTE_KEY_PASSWORD=change-me
